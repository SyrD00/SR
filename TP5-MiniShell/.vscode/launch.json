    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch shell",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/shell",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
           
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "targetArchitecture": "x64",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
    ],
    
}